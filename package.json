{
  "name": "openstreetmap-mcp",
  "version": "0.2.2",
  "description": "MCP server to read and edit OpenStreetMap data via the OSM API v0.6, with OAuth 2.0 authentication",
  "type": "module",
  "bin": {
    "openstreetmap-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "~2.4.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "author": "Soham Patwardhan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TracksideTransport/OpenStreetMap-MCP.git"
  },
  "homepage": "https://github.com/TracksideTransport/OpenStreetMap-MCP#readme",
  "bugs": {
    "url": "https://github.com/TracksideTransport/OpenStreetMap-MCP/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openstreetmap",
    "osm",
    "oauth",
    "maps",
    "geospatial"
  ],
  "publishConfig": {
    "access": "public"
  }
}
